text = input("Enter Plain Text: ").upper()
key = input("Enter Key: ").upper()

cipher = ""
key_index = 0

for ch in text:
    if ch.isalpha():
        shift = ord(key[key_index % len(key)]) - ord('A')
        cipher += chr((ord(ch) - ord('A') + shift) % 26 + ord('A'))
        key_index += 1
    else:
        cipher += ch

print("Encrypted Text:", cipher)
