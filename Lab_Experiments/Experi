# Playfair Cipher Encryption using Given Matrix

matrix = [
    ['M','F','H','I','K'],
    ['U','N','O','P','Q'],
    ['Z','V','W','X','Y'],
    ['E','L','A','R','G'],
    ['D','S','T','B','C']
]

def find(ch):
    if ch == 'J':
        ch = 'I'
    for i in range(5):
        for j in range(5):
            if matrix[i][j] == ch:
                return i, j

text = input("Enter Plain Text: ").upper()
text = text.replace("J", "I")
text = "".join(ch for ch in text if ch.isalpha())

pairs = []
i = 0

while i < len(text):
    a = text[i]

    if i + 1 < len(text):
        b = text[i + 1]

        if a == b:
            pairs.append(a + "X")
            i += 1
        else:
            pairs.append(a + b)
            i += 2
    else:
        pairs.append(a + "X")
        i += 1

cipher = ""

for pair in pairs:
    r1, c1 = find(pair[0])
    r2, c2 = find(pair[1])

    if r1 == r2:
        cipher += matrix[r1][(c1 + 1) % 5]
        cipher += matrix[r2][(c2 + 1) % 5]

    elif c1 == c2:
        cipher += matrix[(r1 + 1) % 5][c1]
        cipher += matrix[(r2 + 1) % 5][c2]

    else:
        cipher += matrix[r1][c2]
        cipher += matrix[r2][c1]

print("Encrypted Text:", cipher)


