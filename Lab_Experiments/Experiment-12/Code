# Hill Cipher Encryption

key = [[9, 4],
       [5, 7]]

text = input("Enter Plain Text: ").upper()
text = text.replace(" ", "")

if len(text) % 2 != 0:
    text += "X"

cipher = ""

for i in range(0, len(text), 2):
    a = ord(text[i]) - ord('A')
    b = ord(text[i + 1]) - ord('A')

    c1 = (key[0][0] * a + key[0][1] * b) % 26
    c2 = (key[1][0] * a + key[1][1] * b) % 26

    cipher += chr(c1 + ord('A'))
    cipher += chr(c2 + ord('A'))

print("Encrypted Text:", cipher)
