# Letter Frequency Attack

cipher = input("Enter Cipher Text: ").upper()
n = int(input("Enter number of possible plaintexts: "))

for shift in range(n):
    plain = ""

    for ch in cipher:
        if ch.isalpha():
            x = (ord(ch) - ord('A') - shift) % 26
            plain += chr(x + ord('A'))
        else:
            plain += ch

    print("Key", shift, ":", plain)
