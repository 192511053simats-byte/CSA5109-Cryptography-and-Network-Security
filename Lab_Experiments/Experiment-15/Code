# Letter Frequency Attack on Additive Cipher

cipher = input("Enter Cipher Text: ").upper()

print("\nPossible Plaintexts:\n")

for key in range(26):
    plain = ""

    for ch in cipher:
        if ch.isalpha():
            p = (ord(ch) - ord('A') - key) % 26
            plain += chr(p + ord('A'))
        else:
            plain += ch

    print("Key", key, ":", plain)
