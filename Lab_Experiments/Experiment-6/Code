# Affine Cipher Decryption

cipher = input("Enter Cipher Text: ").upper()

a = int(input("Enter value of a: "))
b = int(input("Enter value of b: "))

inverse = {
    1:1, 3:9, 5:21, 7:15, 9:3,
    11:19, 15:7, 17:23, 19:11,
    21:5, 23:17, 25:25
}

if a not in inverse:
    print("Invalid value of a")
else:
    ainv = inverse[a]
    plain = ""

    for ch in cipher:
        if ch.isalpha():
            y = ord(ch) - ord('A')
            x = (ainv * (y - b)) % 26
            plain += chr(x + ord('A'))
        else:
            plain += ch

    print("Plain Text:", plain)
