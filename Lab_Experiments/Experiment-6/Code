# Affine Cipher Decryption

cipher = input("Enter Cipher Text: ").upper()
a = 5
b = 8

inverse = {1:1,3:9,5:21,7:15,9:3,11:19,15:7,
17:23,19:11,21:5,23:17,25:25}

ainv = inverse[a]

plain = ""

for ch in cipher:
    if ch.isalpha():
        y = ord(ch)-65
        x = (ainv*(y-b)) % 26
        plain += chr(x+65)
    else:
        plain += ch

print("Plain Text:", plain)
