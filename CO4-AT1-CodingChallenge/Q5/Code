import re


def classify_email(sender, subject, body):

    spam_score = 0
    reasons = []

    # Common spam keywords
    spam_keywords = [
        "free",
        "winner",
        "won",
        "prize",
        "claim",
        "money",
        "urgent",
        "offer",
        "congratulations"
    ]

    # Convert email content to lowercase
    sender_lower = sender.lower()
    subject_lower = subject.lower()
    body_lower = body.lower()

    # Check spam keywords in subject
    for word in spam_keywords:
        if word in subject_lower:
            spam_score += 2
            reasons.append(
                f"Spam keyword in subject: {word}"
            )

    # Check spam keywords in body
    for word in spam_keywords:
        if word in body_lower:
            spam_score += 1
            reasons.append(
                f"Spam keyword in body: {word}"
            )

    # Check suspicious URLs
    urls = re.findall(
        r'https?://[^\s]+',
        body_lower
    )

    if len(urls) >= 2:
        spam_score += 2
        reasons.append("Multiple URLs detected")

    # Check suspicious sender
    if "fake" in sender_lower:
        spam_score += 2
        reasons.append("Suspicious sender address")

    # Final classification
    threshold = 5

    if spam_score >= threshold:
        classification = "SPAM"
    else:
        classification = "LEGITIMATE"

    return classification, spam_score, reasons


