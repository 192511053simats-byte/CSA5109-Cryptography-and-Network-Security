import os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM


# Generate a 256-bit AES key
key = AESGCM.generate_key(bit_length=256)

# Create AES-GCM object
aes = AESGCM(key)

# Original IP packet payload
payload = b"Sensitive IPSec ESP Payload"

# Generate a random 96-bit nonce
nonce = os.urandom(12)

print("Original Payload:")
print(payload.decode())


# ESP Encryption
ciphertext = aes.encrypt(nonce, payload, None)

print("\nEncrypted ESP Payload:")
print(ciphertext.hex())


# ESP Decryption
try:
    decrypted_payload = aes.decrypt(nonce, ciphertext, None)

    print("\nDecrypted Payload:")
    print(decrypted_payload.decode())

    print("\nESP Result:")
    print("Encryption and decryption successful.")

except Exception:
    print("\nESP Result:")
    print("Decryption failed. Data may have been modified.")
