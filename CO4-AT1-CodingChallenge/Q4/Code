from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
import os


# --------------------------------------------------
# 1. Generate Sender RSA Key Pair
# --------------------------------------------------

sender_private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)

sender_public_key = sender_private_key.public_key()


# --------------------------------------------------
# 2. Generate Receiver RSA Key Pair
# --------------------------------------------------

receiver_private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)

receiver_public_key = receiver_private_key.public_key()


print("Sender and receiver RSA keys generated successfully.")


# --------------------------------------------------
# 3. Generate AES Session Key
# --------------------------------------------------

session_key = AESGCM.generate_key(bit_length=256)

sender_aes = AESGCM(session_key)

print("AES-256 session key generated successfully.")


# --------------------------------------------------
# 4. Original Email
# --------------------------------------------------

message = b"Hello, this is a secure S/MIME email."

print("\nOriginal Email:")
print(message.decode())


# --------------------------------------------------
# 5. Encrypt Email using AES-GCM
# --------------------------------------------------

nonce = os.urandom(12)

encrypted_message = sender_aes.encrypt(
    nonce,
    message,
    None
)

print("\nEncrypted Email:")
print(encrypted_message.hex())


# --------------------------------------------------
# 6. Encrypt AES Session Key using Receiver's
#    Public Key
# --------------------------------------------------

encrypted_session_key = receiver_public_key.encrypt(
    session_key,
    padding.OAEP(
        mgf=padding.MGF1(
            algorithm=hashes.SHA256()
        ),
        algorithm=hashes.SHA256(),
        label=None
    )
)

print("\nSession key encrypted using receiver's public key.")


# --------------------------------------------------
# 7. Create Digital Signature using Sender's
#    Private Key
# --------------------------------------------------

signature = sender_private_key.sign(
    message,
    padding.PSS(
        mgf=padding.MGF1(hashes.SHA256()),
        salt_length=padding.PSS.MAX_LENGTH
    ),
    hashes.SHA256()
)

print("Digital signature generated successfully.")


# ==================================================
# Receiver Side
# ==================================================


# --------------------------------------------------
# 8. Decrypt AES Session Key using Receiver's
#    Private Key
# --------------------------------------------------

decrypted_session_key = receiver_private_key.decrypt(
    encrypted_session_key,
    padding.OAEP(
        mgf=padding.MGF1(
            algorithm=hashes.SHA256()
        ),
        algorithm=hashes.SHA256(),
        label=None
    )
)

print("\nSession key decrypted successfully.")


# --------------------------------------------------
# 9. Decrypt Email using AES-GCM
# --------------------------------------------------

receiver_aes = AESGCM(decrypted_session_key)

decrypted_message = receiver_aes.decrypt(
    nonce,
    encrypted_message,
    None
)

print("\nDecrypted Email:")
print(decrypted_message.decode())


# --------------------------------------------------
# 10. Verify Digital Signature
# --------------------------------------------------

try:
    sender_public_key.verify(
        signature,
        decrypted_message,
        padding.PSS(
            mgf=padding.MGF1(hashes.SHA256()),
            salt_length=padding.PSS.MAX_LENGTH
        ),
        hashes.SHA256()
    )

    print("\nDigital Signature: VALID")
    print("Email is authentic and has not been modified.")

except Exception:
    print("\nDigital Signature: INVALID")
    print("Email verification failed.")
